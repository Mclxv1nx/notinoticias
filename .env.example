# Copia este archivo a ".env" (para desarrollo local) o configura estas
# variables en el panel de Vercel (para producción).

# Contraseña del panel de administración (/panel). USA UNA CLAVE FUERTE.
ADMIN_PASSWORD=anahi123

# Base de datos Turso (producción). Se obtienen al crear la base en turso.tech.
TURSO_DATABASE_URL=libsql://TU-BASE.turso.io
TURSO_AUTH_TOKEN=TU-TOKEN

# En local puedes dejar las dos de arriba vacías: se usará un archivo
# SQLite en ./data/data.db automáticamente.
