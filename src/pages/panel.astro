---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Panel · Estadísticas del reportaje">
  <main class="panel">
    <header class="panel__top">
      <div>
        <p class="rule">Panel de administración</p>
        <h1>Estadísticas del reportaje</h1>
      </div>
      <div class="panel__actions">
        <a class="pbtn" href="/" target="_blank" rel="noopener">Ver sitio ↗</a>
        <a class="pbtn" href="/api/logout">Cerrar sesión</a>
      </div>
    </header>

    <!-- Métricas principales -->
    <section class="metrics" aria-label="Métricas">
      <div class="metric"><span class="metric__n" data-p="visitas">—</span><span class="metric__l">Visitas totales</span></div>
      <div class="metric"><span class="metric__n" data-p="visitantes">—</span><span class="metric__l">Visitantes únicos</span></div>
      <div class="metric"><span class="metric__n" data-p="comentarios">—</span><span class="metric__l">Comentarios</span></div>
      <div class="metric"><span class="metric__n" data-p="likes">—</span><span class="metric__l">Me gusta</span></div>
      <div class="metric"><span class="metric__n" data-p="clicks">—</span><span class="metric__l">Clicks / taps</span></div>
    </section>

    <!-- Gráficos -->
    <div class="grid2">
      <section class="card">
        <h2>Visitas por día <span class="muted">(últimos 14)</span></h2>
        <div class="chartbox"><canvas id="chartDia"></canvas></div>
        <p class="empty" data-empty="dia" hidden>Aún no hay visitas registradas.</p>
      </section>
      <section class="card">
        <h2>Visitas por dispositivo</h2>
        <div class="chartbox"><canvas id="chartDisp"></canvas></div>
        <p class="empty" data-empty="disp" hidden>Aún no hay datos.</p>
      </section>
    </div>

    <section class="card">
      <h2>Interacción por sección <span class="muted">(clicks)</span></h2>
      <div class="chartbox chartbox--tall"><canvas id="chartSec"></canvas></div>
      <p class="empty" data-empty="sec" hidden>Aún no hay clicks registrados.</p>
    </section>

    <!-- Mapa de calor -->
    <section class="card">
      <div class="heat__head">
        <h2>Mapa de calor · zonas rojas de clicks</h2>
        <div class="seg" role="group" aria-label="Filtrar por dispositivo">
          <button class="seg__b is-on" data-dev="todos">Todos</button>
          <button class="seg__b" data-dev="desktop">Escritorio</button>
          <button class="seg__b" data-dev="mobile">Móvil</button>
        </div>
      </div>
      <p class="muted heat__note">Cada punto es un click/tap según su posición en la página. Las zonas rojas concentran más interacción.</p>
      <div class="heat__wrap" data-heat-wrap>
        <canvas data-heat></canvas>
        <p class="heat__empty" data-heat-empty hidden>Aún no hay clicks registrados.</p>
      </div>
      <div class="heat__legend"><span>menos</span><span class="heat__ramp"></span><span>más</span></div>
    </section>

    <!-- Comentarios -->
    <section class="card">
      <h2>Comentarios <span class="muted" data-cc></span></h2>
      <div class="modlist" data-modlist><p class="muted">Cargando…</p></div>
    </section>
  </main>

  <style>
    .panel { max-width: 1080px; margin-inline: auto; padding: calc(var(--nav-h) + 1.5rem) var(--gutter) 4rem; }
    .panel__top { display: flex; flex-wrap: wrap; gap: 1rem; align-items: end; justify-content: space-between; margin-bottom: 2rem; }
    .panel__top h1 { font-size: var(--step-3); margin-top: 0.4rem; }
    .panel__actions { display: flex; gap: 0.6rem; }
    .pbtn { border: 1.5px solid var(--line); border-radius: 100px; padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 600; background: var(--white); transition: border-color .25s, transform .25s; }
    .pbtn:hover { border-color: var(--sage-deep); transform: translateY(-2px); }

    .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; margin-bottom: 1.4rem; }
    .metric { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.2rem; }
    .metric__n { display: block; font-family: var(--font-display); font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1; color: var(--terracotta-deep); }
    .metric__l { font-size: var(--step--1); color: var(--ink-soft); }

    .card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.2rem, 3vw, 1.8rem); box-shadow: var(--shadow-sm); margin-bottom: 1.2rem; }
    .card h2 { font-size: var(--step-1); margin-bottom: 1rem; }
    .muted { color: var(--ink-soft); font-size: 0.85em; font-weight: 400; }
    .empty { color: var(--ink-soft); font-style: italic; margin-top: .6rem; }

    .grid2 { display: grid; gap: 1.2rem; }
    .chartbox { position: relative; height: 260px; }
    .chartbox--tall { height: 340px; }

    .heat__head { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; justify-content: space-between; }
    .heat__note { margin: 0.4rem 0 1rem; }
    .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 100px; overflow: hidden; }
    .seg__b { padding: 0.45rem 0.9rem; font-size: 0.82rem; font-weight: 600; color: var(--ink-soft); }
    .seg__b.is-on { background: var(--sage-deep); color: var(--white); }
    .heat__wrap { position: relative; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background:
      repeating-linear-gradient(0deg, #fbf8f2, #fbf8f2 1px, transparent 1px, transparent 40px),
      repeating-linear-gradient(90deg, #fbf8f2, #fbf8f2 1px, transparent 1px, transparent 40px), var(--cream); }
    .heat__wrap canvas { display: block; width: 100%; }
    .heat__empty { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ink-soft); font-style: italic; }
    .heat__legend { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.8rem; font-size: var(--step--1); color: var(--ink-soft); }
    .heat__ramp { flex: 1; max-width: 240px; height: 10px; border-radius: 100px; background: linear-gradient(90deg, #2c6fb0, #38b06f, #e7c93a, #d8632f, #c62d2d); }

    .modlist { display: grid; gap: 0.8rem; }
    .mod { border: 1px solid var(--line); border-left: 3px solid var(--sage); border-radius: var(--radius-sm); padding: 0.9rem 1.1rem; display: grid; gap: 0.3rem; }
    .mod__top { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; }
    .mod__name { font-weight: 600; }
    .mod__date { font-size: 0.75rem; color: var(--ink-soft); }
    .mod__text { color: var(--ink-soft); white-space: pre-wrap; }
    .mod__del { border: 1.5px solid var(--line); border-radius: 100px; padding: 0.3rem 0.8rem; font-size: 0.78rem; font-weight: 600; color: var(--terracotta-deep); }
    .mod__del:hover { border-color: var(--terracotta); }

    @media (min-width: 640px) {
      .metrics { grid-template-columns: repeat(5, 1fr); }
      .grid2 { grid-template-columns: 1.4fr 1fr; }
    }
  </style>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <script is:inline>
    (function () {
      var nf = function (n) { return Number(n || 0).toLocaleString('es-EC'); };
      var charts = {};
      var COL = { sage: '#7e9670', sageSoft: '#a7bb98', terr: '#c79a7e', terrDeep: '#b07f61', ink: '#6c665b', line: '#ece3d5' };

      function draw(id, cfg, hasData, emptyKey) {
        var el = document.getElementById(id);
        var em = document.querySelector('[data-empty="' + emptyKey + '"]');
        if (em) em.hidden = hasData;
        if (!el || !window.Chart) return;
        if (charts[id]) charts[id].destroy();
        if (!hasData) return;
        charts[id] = new Chart(el, cfg);
      }
      function axisOpts(horizontal) {
        return {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: horizontal ? true : false, color: COL.line }, ticks: { color: COL.ink, precision: 0 } },
            y: { grid: { color: COL.line }, beginAtZero: true, ticks: { color: COL.ink, precision: 0 } }
          }
        };
      }

      function renderCharts(d) {
        var dia = d.porDia || [];
        draw('chartDia', {
          type: 'line',
          data: { labels: dia.map(function (x) { return (x.day || '').slice(5); }),
            datasets: [{ label: 'Visitas', data: dia.map(function (x) { return x.n; }),
              borderColor: COL.sage, backgroundColor: 'rgba(126,150,112,0.15)', fill: true, tension: 0.35,
              pointRadius: 3, pointBackgroundColor: COL.sage, borderWidth: 2 }] },
          options: axisOpts(false)
        }, dia.length > 0, 'dia');

        var disp = d.porDispositivo || [];
        draw('chartDisp', {
          type: 'doughnut',
          data: { labels: disp.map(function (x) { return x.device === 'mobile' ? 'Móvil' : 'Escritorio'; }),
            datasets: [{ data: disp.map(function (x) { return x.n; }), backgroundColor: [COL.terr, COL.sage], borderWidth: 0 }] },
          options: { responsive: true, maintainAspectRatio: false, cutout: '62%', plugins: { legend: { position: 'bottom', labels: { color: COL.ink } } } }
        }, disp.length > 0, 'disp');

        var sec = d.porSeccion || [];
        draw('chartSec', {
          type: 'bar',
          data: { labels: sec.map(function (x) { return x.section; }),
            datasets: [{ label: 'Clicks', data: sec.map(function (x) { return x.n; }), backgroundColor: COL.terr, borderRadius: 6 }] },
          options: Object.assign(axisOpts(true), { indexAxis: 'y' })
        }, sec.length > 0, 'sec');
      }

      function renderComments(list) {
        var ml = document.querySelector('[data-modlist]');
        ml.innerHTML = '';
        if (!list.length) { ml.innerHTML = '<p class="muted">Aún no hay comentarios.</p>'; return; }
        list.forEach(function (c) {
          var el = document.createElement('div'); el.className = 'mod';
          var top = document.createElement('div'); top.className = 'mod__top';
          var meta = document.createElement('div');
          var nm = document.createElement('span'); nm.className = 'mod__name'; nm.textContent = c.name;
          var dt = document.createElement('span'); dt.className = 'mod__date'; dt.textContent = '  ' + new Date(c.ts).toLocaleString('es-EC');
          meta.appendChild(nm); meta.appendChild(dt);
          var del = document.createElement('button'); del.className = 'mod__del'; del.textContent = 'Eliminar';
          del.addEventListener('click', function () {
            if (!confirm('¿Eliminar este comentario?')) return;
            fetch('/api/moderar', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: c.id }) }).then(load);
          });
          top.appendChild(meta); top.appendChild(del);
          var tx = document.createElement('p'); tx.className = 'mod__text'; tx.textContent = c.body;
          el.appendChild(top); el.appendChild(tx);
          ml.appendChild(el);
        });
      }

      function load() {
        return fetch('/api/stats').then(function (r) { if (!r.ok) return null; return r.json(); }).then(function (d) {
          if (!d) return;
          ['visitas', 'visitantes', 'comentarios', 'likes', 'clicks'].forEach(function (k) {
            var e = document.querySelector('[data-p="' + k + '"]'); if (e) e.textContent = nf(d[k]);
          });
          var cc = document.querySelector('[data-cc]'); if (cc) cc.textContent = '(' + nf(d.comentarios) + ')';
          renderCharts(d);
          renderComments(d.comentarios_lista || []);
        }).catch(function () {});
      }

      /* ---- Mapa de calor (canvas propio) ---- */
      var rampCache = null;
      function ramp() {
        if (rampCache) return rampCache;
        var c = document.createElement('canvas'); c.width = 256; c.height = 1;
        var x = c.getContext('2d');
        var g = x.createLinearGradient(0, 0, 256, 0);
        g.addColorStop(0.0, '#2c6fb0'); g.addColorStop(0.35, '#38b06f'); g.addColorStop(0.6, '#e7c93a');
        g.addColorStop(0.8, '#d8632f'); g.addColorStop(1.0, '#c62d2d');
        x.fillStyle = g; x.fillRect(0, 0, 256, 1);
        rampCache = x.getImageData(0, 0, 256, 1).data; return rampCache;
      }
      function drawHeat(points) {
        var wrap = document.querySelector('[data-heat-wrap]');
        var canvas = document.querySelector('[data-heat]');
        var empty = document.querySelector('[data-heat-empty]');
        var W = Math.max(320, Math.round(wrap.clientWidth));
        var H = Math.round(W * 1.5);
        canvas.width = W; canvas.height = H;
        var ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, W, H);
        empty.hidden = points.length > 0;
        if (!points.length) return;
        var r = Math.max(16, Math.round(W * 0.035));
        ctx.globalCompositeOperation = 'lighter';
        points.forEach(function (p) {
          var x = p.x * W, y = p.y * H;
          var grad = ctx.createRadialGradient(x, y, 0, x, y, r);
          grad.addColorStop(0, 'rgba(0,0,0,0.16)'); grad.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = grad; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
        });
        ctx.globalCompositeOperation = 'source-over';
        var img = ctx.getImageData(0, 0, W, H); var data = img.data; var rmp = ramp();
        for (var i = 0; i < data.length; i += 4) {
          var a = data[i + 3]; if (!a) continue;
          var idx = Math.min(255, a) * 4;
          data[i] = rmp[idx]; data[i + 1] = rmp[idx + 1]; data[i + 2] = rmp[idx + 2];
          data[i + 3] = Math.min(235, a + 40);
        }
        ctx.putImageData(img, 0, 0);
      }
      var currentDev = 'todos';
      function loadHeatmap() {
        fetch('/api/heatmap?device=' + currentDev).then(function (r) { if (!r.ok) return null; return r.json(); })
          .then(function (d) { if (d) drawHeat(d.puntos || []); }).catch(function () {});
      }
      document.querySelectorAll('[data-dev]').forEach(function (b) {
        b.addEventListener('click', function () {
          document.querySelectorAll('[data-dev]').forEach(function (x) { x.classList.remove('is-on'); });
          b.classList.add('is-on'); currentDev = b.dataset.dev; loadHeatmap();
        });
      });
      var rt;
      window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(loadHeatmap, 250); });

      load(); loadHeatmap();
      setInterval(load, 30000);
    })();
  </script>
</Layout>
