---
// Comentarios de los lectores.
// Persisten en el servidor (base de datos SQLite) mediante /api/comentarios,
// por lo que se comparten entre todos los visitantes.
---

<section class="section" id="comentarios">
  <div class="container">
    <div class="section__head" data-reveal>
      <p class="rule">07 · Comentarios</p>
      <h2>Deja tu opinión</h2>
      <p class="section__lead">
        Comparte tu reflexión sobre el reportaje. Tu comentario quedará publicado
        para el resto de visitantes.
      </p>
    </div>

    <div class="comentarios__box">
      <form class="comentarios__form" data-comment-form data-reveal>
        <div class="comentarios__row">
          <div class="field">
            <label for="k-nombre">Tu nombre</label>
            <input id="k-nombre" name="nombre" type="text" required placeholder="¿Cómo te llamas?" maxlength="60" />
          </div>
        </div>
        <div class="field">
          <label for="k-texto">Comentario</label>
          <textarea id="k-texto" name="texto" required placeholder="Escribe tu comentario…" maxlength="600"></textarea>
        </div>
        <button type="submit" class="btn btn--primary" style="justify-self:start">Publicar comentario</button>
      </form>

      <div class="comentarios__list" data-comment-list>
        <div class="comentarios__tools" data-comment-tools hidden>
          <div class="comentarios__search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="search" data-comment-search placeholder="Buscar comentarios…" aria-label="Buscar comentarios" />
          </div>
          <span class="comentarios__count" data-comment-count role="status"></span>
        </div>

        <div class="comentarios__items" data-comment-items>
          <p class="comentarios__empty" data-comment-empty>Aún no hay comentarios. ¡Sé la primera persona en escribir!</p>
        </div>

        <p class="comentarios__noresults" data-comment-noresults hidden>No se encontraron comentarios que coincidan con tu búsqueda.</p>

        <nav class="comentarios__pager" data-comment-pager aria-label="Paginación de comentarios" hidden>
          <button type="button" class="comentarios__pagebtn" data-comment-prev>← Anteriores</button>
          <span class="comentarios__pageinfo" data-comment-pageinfo></span>
          <button type="button" class="comentarios__pagebtn" data-comment-next>Siguientes →</button>
        </nav>
      </div>
    </div>
  </div>
</section>
