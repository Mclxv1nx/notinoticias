---
import { reportaje, artesanos } from '../data/reportaje.js';
---

<section class="section" id="reportaje">
  <div class="container">
    <div class="section__head" data-reveal>
      <p class="rule">01 · Reportaje</p>
      <h2>{reportaje.titulo}</h2>
    </div>

    <p class="reportaje__lead" data-reveal data-parallax="0.06">{reportaje.entradilla}</p>

    <!-- Bloques narrativos con imagen de apoyo -->
    <div class="reportaje__bloques">
      {reportaje.bloques.map((b) => (
        <article class="bloque">
          <div class="bloque__text" data-reveal>
            <h3>{b.titulo}</h3>
            {b.parrafos.map((p) => <p>{p}</p>)}
          </div>
          <div class="bloque__media" data-reveal>
            <figure data-tilt>
              <img src={b.imagen} alt={b.credito} width="1280" height="963" loading="lazy" />
            </figure>
            <figcaption>{b.credito}</figcaption>
          </div>
        </article>
      ))}
    </div>

    <!-- Perfiles de los cinco maestros -->
    <div class="maestros__head" style="margin-top: clamp(3rem, 7vw, 5rem)">
      <div data-reveal>
        <p class="rule">Testimonios</p>
        <h2 style="font-size: var(--step-3); margin-top: .5rem">Cinco voces, un mismo oficio</h2>
      </div>
      <p class="section__lead" style="margin:0; max-width: 26ch" data-reveal>
        Cada maestro comparte, en su entrevista, una parte de la historia.
      </p>
    </div>

    <div class="maestros">
      {artesanos.map((a) => (
        <article class="maestro" id={`maestro-${a.numero}`}>
          <div class="maestro__media" data-reveal data-tilt>
            <img src={a.imagen} alt={`Retrato del maestro tallador ${a.nombre}.`} width="1280" height="963" loading="lazy" />
            <span class="maestro__num">{String(a.numero).padStart(2, '0')}</span>
          </div>
          <div class="maestro__body" data-reveal>
            <p class="eyebrow">Entrevista N.º {a.numero}</p>
            <h3 class="maestro__name">{a.nombre}</h3>
            <p class="maestro__titular">«{a.titular}»</p>
            <p class="maestro__resumen">{a.resumen}</p>
            <div class="maestro__tags">
              {a.trayectoria && <span class="chip">{a.trayectoria} años de trayectoria</span>}
              <span class="chip">Tallado en madera</span>
            </div>
            <a class="maestro__watch" href={`#video-${a.numero}`}>
              Ver la entrevista completa
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
