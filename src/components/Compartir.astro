---
// Botones para compartir el reportaje en redes sociales.
---

<section class="section" style="padding-top:0" aria-label="Compartir el reportaje">
  <div class="container">
    <div class="share" data-share data-reveal>
      <span class="share__label">Comparte este reportaje</span>

      <button type="button" class="like" data-like aria-pressed="false" aria-label="Me gusta esta página">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
        Me gusta · <span data-like-count>0</span>
      </button>

      <button type="button" data-share-native>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
        Compartir
      </button>

      <button type="button" data-share-copy>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
        <span data-copy-label>Copiar enlace</span>
      </button>

      <button type="button" data-share-net="youtube">YouTube</button>
      <button type="button" data-share-net="instagram">Instagram</button>
      <button type="button" data-share-net="tiktok">TikTok</button>
    </div>
  </div>
</section>
