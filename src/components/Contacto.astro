---
import { contacto } from "../data/reportaje.js";

const iconos: Record<string, string> = {
  youtube:
    '<path d="M23 12s0-3.5-.4-5.1a2.6 2.6 0 0 0-1.8-1.8C19 4.7 12 4.7 12 4.7s-7 0-8.8.4A2.6 2.6 0 0 0 1.4 6.9C1 8.5 1 12 1 12s0 3.5.4 5.1a2.6 2.6 0 0 0 1.8 1.8c1.8.4 8.8.4 8.8.4s7 0 8.8-.4a2.6 2.6 0 0 0 1.8-1.8C23 15.5 23 12 23 12ZM9.8 15.3V8.7l5.7 3.3-5.7 3.3Z"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.4"/>',
  tiktok:
    '<path d="M16.5 3c.3 2.1 1.6 3.6 3.7 3.8v2.4c-1.3.1-2.5-.3-3.6-1v5.7a5.3 5.3 0 1 1-5.3-5.3c.3 0 .6 0 .9.1v2.6a2.8 2.8 0 1 0 2 2.7V3h2.3Z"/>',
  facebook:
    '<path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/>',
  x:
    '<path d="M18.9 2.3h3.3l-7.2 8.2 8.5 11.2h-6.6l-5.2-6.8-6 6.8H2.4l7.7-8.8L2 2.3h6.8l4.7 6.2 5.4-6.2Zm-1.2 17.6h1.8L7.2 4.1H5.3l12.4 15.8Z"/>',
};
---

<section class="section" id="contacto">
  <div class="container">
    <div class="section__head" data-reveal>
      <p class="rule">06 · Contacto</p>
      <h2>Hablemos sobre el oficio</h2>
    </div>

    <div class="contacto">
      <div class="contacto__intro" data-reveal>
        <p>{contacto.mensaje}</p>

        <div class="redes">
          {
            contacto.redes.map((r) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={r.nombre}
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  set:html={iconos[r.icono] || ""}
                />
                {r.nombre}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
